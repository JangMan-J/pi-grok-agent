{
  "name": "pi-grok-agent",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Pi model provider for Grok Build: Grok keeps its native harness and tools while Pi drives the session over a local WebSocket ACP gateway",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "model-provider",
    "grok",
    "grok-build",
    "xai",
    "acp",
    "agent-client-protocol",
    "coding-agent"
  ],
  "homepage": "https://github.com/JangMan-J/pi-grok-agent#readme",
  "bugs": {
    "url": "https://github.com/JangMan-J/pi-grok-agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JangMan-J/pi-grok-agent.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-grok-gateway": "dist/scripts/server.js"
  },
  "files": [
    "src",
    "dist",
    "docs/usage.md",
    "docs/first-class-model.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/model.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "server": "node scripts/server.ts",
    "test:live": "scripts/model-live.sh gateway && scripts/hooks-live.sh"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.0"
  }
}
